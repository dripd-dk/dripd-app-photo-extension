{
  "manifest_version": 3,
  "name": "dripd",
  "version": "1.0.0",
  "description": "Henter produktbilleder fra en butiks side, n\u00e5r du selv beder om det p\u00e5 dripd. Intet gemmes.",
  "homepage_url": "https://github.com/dripd-dk/dripd-app-photo-extension",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "scripts": [
      "sw.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://dripd.dk/*",
        "https://www.dripd.dk/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "dripd",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "capture@dripd.dk",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
