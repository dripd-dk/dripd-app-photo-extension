{
  "manifest_version": 3,
  "name": "dripd",
  "version": "0.1.0",
  "description": "Henter produktbilleder fra en butiks side, når du selv beder om det på dripd. Intet gemmes.",
  "permissions": ["scripting", "tabs"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "sw.js",
    "scripts": ["sw.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://dripd.dk/*", "https://www.dripd.dk/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "dripd" },
  "browser_specific_settings": {
    "gecko": { "id": "capture@dripd.dk", "strict_min_version": "121.0" }
  }
}
