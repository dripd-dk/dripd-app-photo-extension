{
  "name": "dripd-capture",
  "version": "1.0.0",
  "description": "Browser extension that lets dripd.dk read product images from a retailer page in the user's own browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dripd-dk/dripd-app-photo-extension.git"
  },
  "homepage": "https://github.com/dripd-dk/dripd-app-photo-extension",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "build:firefox": "node build.mjs --target=firefox",
    "build:firefox:dev": "node build.mjs --target=firefox --dev",
    "test": "node build.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
